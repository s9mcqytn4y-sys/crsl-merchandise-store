# Konfigurasi Lingkungan - CRSL Merchandise Store
# Salin file ini ke .env dan sesuaikan nilai-nilainya

# === Aplikasi ===
APP_NAMA=CRSL Merchandise Store
APP_LINGKUNGAN=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# === Basis Data ===
DB_DRIVER=sqlite
DB_PATH=../data/toko.db

# === Lokalisasi ===
BAHASA_DEFAULT=id
MATA_UANG_DEFAULT=IDR
NEGARA_DEFAULT=ID

# === Keamanan ===
APP_KUNCI_RAHASIA=ganti-dengan-kunci-acak-yang-panjang
SESI_NAMA=crsl_sesi
SESI_MASA_AKTIF=7200
