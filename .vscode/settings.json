{
    // === Tampilan & Tema Dracula CRSL Store ===
    "workbench.colorTheme": "Dracula Theme",
    "workbench.colorCustomizations": {
        "activityBar.background": "#1e1f29",
        "activityBar.foreground": "#f8f8f2",
        "activityBarBadge.background": "#ff79c6",
        "activityBarBadge.foreground": "#1e1f29",
        "sideBar.background": "#21222c",
        "sideBar.foreground": "#f8f8f2",
        "sideBarSectionHeader.background": "#191a21",
        "sideBarSectionHeader.foreground": "#bd93f9",
        "sideBarTitle.foreground": "#bd93f9",
        "editorGroupHeader.tabsBackground": "#191a21",
        "tab.activeBackground": "#282a36",
        "tab.activeForeground": "#f8f8f2",
        "tab.inactiveBackground": "#21222c",
        "tab.inactiveForeground": "#6272a4",
        "tab.border": "#191a21",
        "statusBar.background": "#191a21",
        "statusBar.foreground": "#f8f8f2",
        "statusBar.noFolderBackground": "#191a21",
        "titleBar.activeBackground": "#21222c",
        "titleBar.activeForeground": "#f8f8f2",
        "terminal.background": "#282a36",
        "terminal.foreground": "#f8f8f2"
    },

    // === Editor & Formatter Umum ===
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "explicit"
    },

    // === TypeScript & Workspace TSDK ===
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "typescript.suggest.completeFunctionCalls": true,
    "javascript.suggest.completeFunctionCalls": true,

    // === Formatter Berdasarkan Bahasa ===
    "[typescript]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[blade]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "shufo.vscode-blade-formatter"
    },
    "[php]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
    },

    // === Ekstensi File & Asosiasi Bahasa ===
    "files.associations": {
        "*.blade.php": "blade",
        ".env*": "dotenv"
    },

    // === Tailwind CSS IntelliSense Tingkat Lanjut ===
    "tailwindCSS.includeLanguages": {
        "blade": "html",
        "typescriptreact": "html",
        "typescript": "javascript"
    },
    "tailwindCSS.emmetCompletions": true,
    "tailwindCSS.experimental.classRegex": [
        ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
        ["clsx\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
        ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
    ],

    // === Intelephense (Laravel Backend) ===
    "intelephense.environment.phpVersion": "8.2.0",
    "intelephense.environment.includePaths": [
        "vendor/**",
        "_ide_helper.php",
        "_ide_helper_models.php"
    ],
    "intelephense.diagnostics.undefinedClassConstants": true,
    "intelephense.diagnostics.undefinedFunctions": true,
    "intelephense.diagnostics.undefinedTypes": true,

    // === Pengoptimalan Kinerja Watcher ===
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/vendor/**": true,
        "**/storage/**": true,
        "**/public/build/**": true,
        "**/public/hot": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/vendor": true,
        "**/storage/framework": true,
        "**/public/build": true
    }
}
